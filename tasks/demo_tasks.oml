// CA-PIP three-task demo definitions.
//
// Memory regions live in TASKRAM (kernel/memory.x, 0x800B_8000..0x800C_0000).
// Each region is 4 KB, 4 KB aligned (one NAPOT PMP entry) and holds the task's
// stack; the boot code halts if the linker placement differs from these values.
//
// Peripheral bitmasks (one-hot encoding, matches kernel/src/demo.rs):
//   UART0   = bit 0   (exclusive_cap_mask = 0x0000_0001)
//   CONSOLE = bit 31  (shared_cap_mask = 0x8000_0000) — permission to use the
//             `log` syscall; shared, so it creates no CCG edges.
//
// Expected CA-PIP behaviour after boot:
//   MIP(L) = max(H.priority) = 3  →  eff_pri(L) = 3
//   MIP(M) = M.priority      = 2  →  eff_pri(M) = 2
//   MIP(H) = H.priority      = 3  →  eff_pri(H) = 3
//
//   L cannot be preempted by M (eff_pri(L)=3 > priority(M)=2) while L holds UART0.
//   H runs immediately when UART0 becomes available.

import "task.oml";

// --- Task L — low priority holder ----------------------------------------
// Holds UART0 exclusively (exclusive_cap_mask = 0x1).
// MIP is raised to 3 by the CCG because H requires UART0.
instance TASK_L: TaskConfig {
    priority = 1;
    stack_size = 4096;
    memory_start = 0x800B_8000;
    memory_end = 0x800B_9000;
    exclusive_cap_mask = 0x0000_0001;
    shared_cap_mask = 0x8000_0000;
    required_cap_mask = 0;
}

// --- Task M — medium priority, CPU-bound ---------------------------------
// No capability contention; MIP = own priority.
instance TASK_M: TaskConfig {
    priority = 2;
    stack_size = 4096;
    memory_start = 0x800B_9000;
    memory_end = 0x800B_A000;
    exclusive_cap_mask = 0;
    shared_cap_mask = 0x8000_0000;
    required_cap_mask = 0;
}

// --- Task H — high priority waiter ---------------------------------------
// Requires UART0 (required_cap_mask = 0x1), does not hold it at boot.
// Creates the CCG edge L→H that raises MIP(L).
instance TASK_H: TaskConfig {
    priority = 3;
    stack_size = 4096;
    memory_start = 0x800B_A000;
    memory_end = 0x800B_B000;
    exclusive_cap_mask = 0;
    shared_cap_mask = 0x8000_0000;
    required_cap_mask = 0x0000_0001;
}

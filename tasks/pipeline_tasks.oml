// Sensor-fusion pipeline (Sprint 10) — the default demo.
//
//   sensor_reader --Channel 0--> filter --Channel 1--> uart_logger
//
// Memory regions live in TASKRAM (kernel/memory.x); slot n's 4 KB region is
// 0x800B_8000 + n * 0x1000 and holds the task's stack.
//
// Peripheral bitmasks (one-hot):
//   UART0   = bit 0   logger's output UART          (exclusive, logger)
//   UART1   = bit 1   simulated sensor interface    (exclusive, sensor_reader)
//   CONSOLE = bit 31  `log` syscall permission      (shared, all tasks)
// Channel masks: bit i = endpoint of channel i (sends_mask / receives_mask).
//
// No task requires a peripheral another task holds, so the CCG has no edges
// and every effective priority equals its base priority: sensor_reader (3)
// always preempts filter (2) and uart_logger (1).

import "task.oml";

// --- sensor_reader — priority 3, 10 ms period ----------------------------
instance SENSOR_READER: TaskConfig {
    priority = 3;
    stack_size = 4096;
    memory_start = 0x800B_8000;
    memory_end = 0x800B_9000;
    exclusive_cap_mask = 0x0000_0002;
    shared_cap_mask = 0x8000_0000;
    required_cap_mask = 0;
    sends_mask = 0x1;
    receives_mask = 0;
}

// --- filter — priority 2, moving average ---------------------------------
instance FILTER: TaskConfig {
    priority = 2;
    stack_size = 4096;
    memory_start = 0x800B_9000;
    memory_end = 0x800B_A000;
    exclusive_cap_mask = 0;
    shared_cap_mask = 0x8000_0000;
    required_cap_mask = 0;
    sends_mask = 0x2;
    receives_mask = 0x1;
}

// --- uart_logger — priority 1, slow formatted output ---------------------
instance UART_LOGGER: TaskConfig {
    priority = 1;
    stack_size = 4096;
    memory_start = 0x800B_A000;
    memory_end = 0x800B_B000;
    exclusive_cap_mask = 0x0000_0001;
    shared_cap_mask = 0x8000_0000;
    required_cap_mask = 0;
    sends_mask = 0;
    receives_mask = 0x2;
}
